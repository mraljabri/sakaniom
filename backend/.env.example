# Copy this file to .env and fill in your values for local development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/oman-rentals?retryWrites=true&w=majority

# Any long random string for JWT signing
JWT_SECRET=replace-this-with-a-long-random-secret

# Cloudinary credentials (from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
